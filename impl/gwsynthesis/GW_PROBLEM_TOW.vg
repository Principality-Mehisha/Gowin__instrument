module uart_score_control (
  sys_clk_d,
  n12_6,
  selected_marimba_Z,
  pressure_fault,
  effect_fault,
  bridge_fault_Z,
  player_reset_n,
  uart_rx_d,
  selected_note_Z,
  player_state,
  selected_track_Z,
  control_error,
  raw_uart_play,
  uart_stop,
  uart_note_previous,
  uart_note_next,
  uart_note_play,
  uart_note_all_play,
  uart_select_piano,
  uart_select_marimba,
  guide_mode_Z,
  guide_changed_Z,
  reported_error_6_4,
  reported_error_6_5,
  uart_tx_d,
  uart_track,
  display_mode_Z,
  effect_mode_Z,
  effect_amount_Z
)
;
input sys_clk_d;
input n12_6;
input selected_marimba_Z;
input pressure_fault;
input effect_fault;
input bridge_fault_Z;
input player_reset_n;
input uart_rx_d;
input [6:0] selected_note_Z;
input [2:0] player_state;
input [7:0] selected_track_Z;
input [6:0] control_error;
output raw_uart_play;
output uart_stop;
output uart_note_previous;
output uart_note_next;
output uart_note_play;
output uart_note_all_play;
output uart_select_piano;
output uart_select_marimba;
output guide_mode_Z;
output guide_changed_Z;
output reported_error_6_4;
output reported_error_6_5;
output uart_tx_d;
output [7:0] uart_track;
output [1:0] display_mode_Z;
output [1:0] effect_mode_Z;
output [6:0] effect_amount_Z;
